# Copie este arquivo para .env e preencha. NUNCA envie o .env para o Git.
# Estes valores são apenas exemplos — não são credenciais reais.

# development | test | production
APP_ENV=development

# Obrigatória em produção (mínimo 32 caracteres aleatórios).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Caminhos dos dados (opcional; o padrão fica em ./instance)
# DATABASE_PATH=/var/lib/revenda-master/producao.sqlite3
# UPLOAD_DIR=/var/lib/revenda-master/uploads
# LOG_DIR=/var/log/revenda-master

# Dados públicos da loja (aparecem no site)
WHATSAPP_NUMBER=5511999999999
STORE_ADDRESS=Av. Imperial, 1200, Centro

# Sessão e uploads
SESSION_HOURS=8
MAX_UPLOAD_MB=5
MAX_PHOTOS_PER_VEHICLE=12

# Cookie só por HTTPS (padrão: ligado em produção, desligado nos demais)
# COOKIE_SECURE=true

# Proteção de login: tentativas por janela de tempo (segundos)
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900

# Atrás de proxy reverso (nginx etc.): quantos proxies confiáveis existem (0 = nenhum)
TRUST_PROXY_HOPS=0

# CORS: origens extras autorizadas, separadas por vírgula (vazio = só o próprio site)
# ALLOWED_ORIGINS=https://www.exemplo.com.br

# Usadas apenas pelo script create_admin.py (apague depois de criar o administrador)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
